+
+# 测试 FileBrowser
+curl -s http://localhost:8081/ | head -5
+
+# 测试 rclone S3 API
+curl -s http://localhost:9000/
+echo  # 添加换行
+
+# 测试防火墙
+sudo ufw status verbose

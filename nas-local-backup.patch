+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			// 创建临时 .env 文件
+			tmpDir := t.TempDir()
+			envPath := filepath.Join(tmpDir, ".env")
+			if err := os.WriteFile(envPath, []byte(tt.content), 0644); err != nil {
+				t.Fatalf("WriteFile failed: %v", err)

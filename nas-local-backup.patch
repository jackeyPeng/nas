-# 永久挂载（加入 /etc/fstab）
-echo '//192.168.213.85/shared /mnt/nas cifs credentials=/etc/samba/credentials,uid=1000,gid=1000 0 0' | sudo tee -a /etc/fstab
-echo 'username=<NAS_USER>' | sudo tee /etc/samba/credentials

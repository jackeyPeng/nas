+    echo "已取消"
+    exit 0
+fi
+
+echo ""
+
+# ==================== [1/7] 停止所有 NAS 服务 ====================
+echo "[1/7] 停止所有 NAS 服务..."
+SERVICES="smbd nmbd nfs-kernel-server vsftpd rclone-webdav filebrowser rclone-s3 fail2ban nas-panel"
+for svc in $SERVICES; do
+    if systemctl is-active --quiet "$svc" 2>/dev/null; then

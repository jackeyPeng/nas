# NAS 部署配置文件
# 
# 使用方法：
#   cp .env.example .env
#   然后编辑 .env，把下面的值改成你自己的
#
# ┌─────────────────────────────────────────────────────────┐
# │ 变量          │ 必填 │ 说明                                 │
# ├───────────────┼──────┼────────────────────────────────────-─┤
# │ NAS_PASS      │ 是   │ NAS 管理密码，至少 12 位             │
# │               │      │ 用于 Samba/FTP/WebDAV/FileBrowser/   │
# │               │      │ MinIO 等所有服务                     │
# │ GITEE_TOKEN   │ 否   │ Gitee API token，仅用于创建 Release  │
# │               │      │ 不创建 Release 可不填                │
# └─────────────────────────────────────────────────────────┘
#
# 示例：
#   NAS_PASS=MyStr0ngP@ss2026
#   GITEE_TOKEN=abc123def456

NAS_PASS=changeme123456
GITEE_TOKEN=your_gitee_token_here

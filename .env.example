# NAS 部署配置文件
# 
# 使用方法：
#   cp .env.example .env
#   然后编辑 .env，把下面的值改成你自己的
#
# ┌─────────────────────────────────────────────────────────┐
# │ 变量          │ 必填 │ 说明                                 │
# ├───────────────┼──────┼────────────────────────────────────-─┤
# │ NAS_PASS      │ 是   │ NAS 管理密码，至少 12 位             │
# │               │      │ 用于 Samba/FTP/WebDAV/FileBrowser/   │
# │               │      │ MinIO 等所有服务                     │
# │ GITEE_TOKEN   │ 否   │ Gitee API token，仅用于创建 Release  │
# │               │      │ 不创建 Release 可不填                │
# └─────────────────────────────────────────────────────────┘
#
# 示例：
#   NAS_PASS=MyStr0ngP@ss2026
#   GITEE_TOKEN=abc123def456

NAS_PASS=changeme123456
GITEE_TOKEN=your_gitee_token_here

# ═══ 告警通知（可选，配哪个启用哪个） ═══
# 详见 configs/alert.conf.example

# 钉钉机器人
#ALERT_DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
#ALERT_DINGTALK_SECRET=SECxxx

# Telegram Bot
#ALERT_TELEGRAM_TOKEN=123456:ABCxxx
#ALERT_TELEGRAM_CHAT_ID=123456789

# Bark (iOS 推送，可自建)
#ALERT_BARK_KEY=xxx
#ALERT_BARK_SERVER=https://api.day.app

# Email (SMTP)
#ALERT_SMTP_HOST=smtp.qq.com
#ALERT_SMTP_PORT=465
#ALERT_SMTP_USER=you@qq.com
#ALERT_SMTP_PASS=授权码
#ALERT_SMTP_FROM=you@qq.com
#ALERT_SMTP_TO=you@qq.com

# 告警阈值
#ALERT_DISK_THRESHOLD=80
#ALERT_MEM_THRESHOLD=90
#ALERT_LOAD_THRESHOLD=4

# ═══ Cloudflare R2 (upload-r2.sh) ═══
# 用于上传 install.sh 到 R2 存储，供 curl | bash 安装
# 在 Cloudflare Dashboard → R2 → Manage API Tokens 获取
#CLOUDFLARE_ID=your-cloudflare-account-id
#CLOUDFLARE_KEY_ID=your-r2-access-key-id
#CLOUDFLARE_SECRET=your-r2-secret-access-key
#CLOUDFLARE_S3_API=https://your-account-id.r2.cloudflarestorage.com

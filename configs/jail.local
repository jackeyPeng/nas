[DEFAULT]
# 家用放宽策略（2026-09-24）：ban 10 分钟、允许 10 次尝试，避免用户输错密码把自己锁在门外
bantime = 600
findtime = 600
maxretry = 10

[sshd]
enabled = true
port = ssh
filter = sshd
logpath = /var/log/auth.log
maxretry = 10

[vsftpd]
enabled = true
port = ftp,ftp-data,ftps,ftps-data
filter = vsftpd
logpath = /var/log/vsftpd.log
maxretry = 10

+                            </div>
+                            <div x-show="showTaskAdvanced" style="padding:0 14px 14px">
+                                <div class="form-group">
+                                    <label>定时同步（cron 表达式，留空表示手动）</label>
+                                    <input type="text" x-model="taskForm.schedule" placeholder="如: 0 2 * * * = 每天 02:00">
+                                </div>
+                                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
+                                    <div class="form-group" style="margin-bottom:0">
+                                        <label>带宽限制 (KB/s)</label>
+                                        <input type="number" x-model="taskForm.bandwidth" placeholder="0 = 不限">
+                                    </div>
+                                    <div class="form-group" style="margin-bottom:0">
+                                        <label>并发数</label>
+                                        <input type="number" x-model="taskForm.transfers" placeholder="默认 4" value="4">
+                                    </div>
+                                </div>
+                            </div>
+                        </div>
+                        <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:20px">
+                            <button class="btn" @click="showAddTask = false">取消</button>
+                            <button class="btn btn-primary" @click="saveTask()" :disabled="taskCreating">
+                                <span x-show="!taskCreating" x-text="editingTask ? '保存' : '创建'"></span>
+                                <span x-show="taskCreating" x-text="editingTask ? '保存中...' : '创建中...'"></span>
+                            </button>
+                        </div>
+                    </div>
+                </div>
+            </div>
+
+        </main>
+    </div>
+
+    <!-- Toast -->
+    <div class="toast" x-show="toast.show" x-cloak :class="toast.type" x-text="toast.msg"></div>
+</div>
+<script src="app.js"></script>
+</body>
+</html>

+    cd "$BACKUP_ROOT"
+    find etc -type f | while read file; do
+        target="/$file"
+        target_dir=$(dirname "$target")
+        mkdir -p "$target_dir"
+        cp -a "$file" "$target"
+        echo "  ✓ $target"
+    done
+    echo "  ✓ 系统配置文件已恢复"
+else
+    echo "  ⚠ 无系统配置文件"
+fi
+
+# ═══════════════════════════════════════

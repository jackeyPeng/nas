+#!/bin/bash
+# NAS 清除脚本
+# 用于将系统恢复到安装前的状态
+# 用法: sudo ./cleanup.sh [--keep-data]
+#
+# 选项:
+#   --keep-data    保留 /data 目录（默认会删除）
+
+set -e
+
+# 检查 root 权限
+if [ "$EUID" -ne 0 ]; then
+    echo "错误: 请使用 sudo 运行此脚本"
+    exit 1
+fi
+
+KEEP_DATA=false
+if [ "$1" = "--keep-data" ]; then
+    KEEP_DATA=true
+fi
+
+echo "========================================="
+echo "NAS 清除脚本"
+echo "========================================="
+echo ""
+
+if [ "$KEEP_DATA" = true ]; then
+    echo "⚠️  将保留 /data 目录"
+else
+    echo "⚠️  将删除 /data 目录及所有数据"
+fi
+
+echo ""

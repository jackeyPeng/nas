+    mkdir -p /opt/nas
+    cp -a "$BACKUP_ROOT/opt/nas/.env" /opt/nas/
+    echo "  ✓ /opt/nas/.env"
+fi
+
+if [ -d "$BACKUP_ROOT/opt/nas/configs" ]; then
+    cp -a "$BACKUP_ROOT/opt/nas/configs" /opt/nas/
+    echo "  ✓ /opt/nas/configs/"
+fi
+
+echo "  ✓ NAS 项目配置已恢复"
+
+# ═══════════════════════════════════════
